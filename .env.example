# Demo mode generates realistic simulated outage signals so the app works
# without any licensed data feeds. Set to "false" in production.
DEMO_MODE=true

# Licensed third-party feeds (PRD §5.1). Each adapter stays disabled until
# its URL and key are set AND a data agreement is in place.
SOURCE_DOWNDETECTOR_URL=
SOURCE_DOWNDETECTOR_KEY=
SOURCE_OUTAGENOW_URL=
SOURCE_OUTAGENOW_KEY=
SOURCE_SPECTRUMOUTAGE_URL=
SOURCE_SPECTRUMOUTAGE_KEY=
SOURCE_FIBERFINDER_URL=
SOURCE_FIBERFINDER_KEY=
SOURCE_GEOBLACKOUT_URL=
SOURCE_GEOBLACKOUT_KEY=

# Official provider status pages (Atlassian Statuspage format). Off by default.
SOURCE_STATUSPAGES_ENABLED=false

# How often sources are polled and statuses recomputed, in seconds.
POLL_INTERVAL_SECONDS=60
